# Copy to .env.local for local development, and add the same values in your hosting provider.

# Sanity (content). Both values are public.
NEXT_PUBLIC_SANITY_PROJECT_ID=n2374y3w
NEXT_PUBLIC_SANITY_DATASET=production

# Shared secret for the Sanity "publish" webhook (any long random string).
# Must match the secret entered in the webhook at sanity.io/manage.
SANITY_REVALIDATE_SECRET=

# Only needed to run the one-time content import (studio/scripts/import-content.ts).
# Create an "Editor" token at sanity.io/manage → API → Tokens. Never commit it.
SANITY_API_WRITE_TOKEN=

# The live site address, used for Google, the sitemap and link previews.
NEXT_PUBLIC_SITE_URL=https://www.skandiora.com
